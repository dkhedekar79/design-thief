{
  "name": "design-thief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Open-source design system extractor: give it a URL, get a brand board and a Claude Code prompt.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
